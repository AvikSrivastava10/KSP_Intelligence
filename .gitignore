node_modules/
datasets/

# --- Secrets (never commit) ---
# Re-added ahead of the Catalyst Data Store step, which needs ZOHO_CLIENT_SECRET /
# ZOHO_REFRESH_TOKEN in the environment. A committed .env cannot be fully un-published.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
client-secret*.json
service-account*.json

# --- Python bytecode and caches (auto-generated, never source) ---
__pycache__/
*.py[cod]
*.pyo

# --- Intermediate pipeline artefacts (large binary; regenerable from the ETL) ---
# Parquet files at the FULL case grain. None are served by the API (which is aggregate-only) and
# all rebuild deterministically from the source extract in about a minute:
#   case_features.parquet           build_modeling_table.py  1.67M rows — ML feature table
#   case_master.parquet             build_er_core.py         1.67M rows — ER CaseMaster
#   act_section_association.parquet build_er_core.py         4.93M rows — ER one-to-many act/section
# A wildcard rather than one line per file, so the next case-grain table cannot be committed by
# accident. er_core_stats.json IS tracked: it carries the row counts and provenance behind the
# published ER conformance numbers, which should survive without the binaries.
etl/out/*.parquet

# --- Zia AutoML upload artifact (12 MB, regenerable, deterministic) ---
# case_outcome_train.csv exists only to be uploaded to the AutoML console. It rebuilds identically
# from a fixed seed via `python ml/zia_benchmark.py --export`, so committing 12 MB per regeneration
# would bloat history for nothing.
# The two 2,000-row HOLDOUT files ARE tracked on purpose: they are the scoring key behind the
# published benchmark numbers, so a reviewer can re-score any model against the same rows.
ml/out/zia/case_outcome_train.csv

# --- Serialized model binaries (regenerable; keep git history lean) ---
# ml/models/*.joblib totals ~14 MB and is rewritten on every retrain — committing it would add
# a fresh multi-MB blob to history each time, permanently. The artifacts rebuild in ~3 min via
# `python ml/outcomes.py && python ml/risk.py && python ml/anomaly.py`.
# ml/models/registry.json IS tracked: it records what was trained, when, and with what metrics,
# so the audit trail survives without the bloat.
# To version the binaries instead, delete the next line (consider Git LFS if you do).
ml/models/*.joblib

# --- client/dist IS intentionally tracked ---
# The Catalyst Web Client Hosting deployment reads from this directory.
# Run `cd client && npm run build` before deploying to keep it current.
