{
  "deployment": {
    "name": "crime_api",
    "stack": "node18",
    "type": "advancedio",
    "memory": 512,
    "env_variables": {
      "USE_DATASTORE": "true",
      "USE_CACHE": "true",
      "USE_CATALYST_CACHE": "true",
      "CACHE_TTL_HOURS": "1",
      "USE_API_GATEWAY": "false",
      "ALLOWED_ORIGINS": "",
      "RATE_LIMIT_MAX": "200",
      "RATE_LIMIT_WINDOW_MS": "60000",
      "MAX_BODY": "256kb"
    }
  },
  "execution": {
    "main": "src/index.js"
  }
}
